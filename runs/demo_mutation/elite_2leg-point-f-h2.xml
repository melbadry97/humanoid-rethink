      </body>
      <body name="chest" pos="0.000 0 0.05">
        <joint name="spine" type="hinge" axis="0 1 0" range="-40.0 40.0" damping="1.0" armature="0.01" stiffness="16.404" springref="0"/>
        <geom type="box" pos="0 0 0.129" size="0.09 0.143 0.129" density="350" rgba=".8 .5 .3 1"/>
        <geom type="sphere" pos="0 0 0.359" size="0.09" density="400" rgba=".9 .9 .9 1"/>
      </body>
      <body name="tail" pos="-0.365 0 0">
        <joint name="tail" type="hinge" axis="0 1 0" range="-60.0 60.0" damping="1.0" armature="0.01"/>
        <geom type="capsule" fromto="0 0 0 -0.019 0 0.05" size="0.025" density="600" rgba=".7 .6 .5 1"/>
      </body>
    </body>
