  <actuator>
    <position name="hiproll_l" joint="hiproll_l" kp="222.3" kv="5.56" inheritrange="1" forcelimited="true" forcerange="-111.1 111.1"/>
    <position name="hippitch_l" joint="hippitch_l" kp="222.3" kv="5.56" inheritrange="1" forcelimited="true" forcerange="-111.1 111.1"/>
