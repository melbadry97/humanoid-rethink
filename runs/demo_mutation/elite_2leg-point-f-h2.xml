          <geom name="foot_l" type="sphere" pos="0 0 -0.250" size="0.035" friction="1.2" rgba=".2 .2 .2 1"/>
        </body>
      </body>
      <body name="thigh_r" pos="0.000 -0.143 0">
        <joint name="hiproll_r" type="hinge" axis="1 0 0" range="-30.0 30.0" damping="1.0" armature="0.01"/>
        <joint name="hippitch_r" type="hinge" axis="0 1 0" range="-120.0 60.0" damping="1.0" armature="0.01"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.253" size="0.035" rgba=".55 .6 .7 1"/>
        <body name="shin_r" pos="0 0 -0.253">
          <joint name="knee_r" type="hinge" axis="0 1 0" range="0.0 150.0" damping="1.0" armature="0.01" stiffness="22.396" springref="0"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.250" size="0.030" rgba=".45 .5 .6 1"/>
