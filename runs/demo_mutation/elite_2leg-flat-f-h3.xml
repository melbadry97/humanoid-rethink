<mujoco model="hrethink">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>
  <!-- robot geoms collide only with the environment, not with each other -->
  <default><geom contype="1" conaffinity="0" condim="3" density="800"/></default>
  <worldbody>
    <light pos="0 0 4" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="20 20 0.1" contype="0" conaffinity="1" rgba=".85 .85 .8 1" friction="1.0"/>
    
    <body name="pelvis" pos="0 0 0.740">
      <freejoint name="root"/>
      <geom name="pelvis" type="box" size="0.125 0.150 0.05" density="500" rgba=".8 .5 .3 1"/>
      <site name="imu" pos="0 0 0"/>
      <body name="thigh_l" pos="0.000 0.130 0">
        <joint name="hiproll_l" type="hinge" axis="1 0 0" range="-30.0 30.0" damping="1.0" armature="0.01"/>
        <joint name="hippitch_l" type="hinge" axis="0 1 0" range="-120.0 60.0" damping="1.0" armature="0.01"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.320" size="0.035" rgba=".55 .6 .7 1"/>
        <body name="shin_l" pos="0 0 -0.320">
          <joint name="knee_l" type="hinge" axis="0 1 0" range="0.0 150.0" damping="1.0" armature="0.01"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.320" size="0.030" rgba=".45 .5 .6 1"/>
          <body name="foot_l" pos="0 0 -0.320">
            <joint name="ankle_l" type="hinge" axis="0 1 0" range="-45.0 45.0" damping="1.0" armature="0.01"/>
            <geom name="foot_l" type="box" pos="0.036 0 -0.02" size="0.090 0.045 0.02" friction="1.0" rgba=".2 .2 .2 1"/>
          </body>
        </body>
      </body>
      <body name="thigh_r" pos="0.000 -0.130 0">
        <joint name="hiproll_r" type="hinge" axis="1 0 0" range="-30.0 30.0" damping="1.0" armature="0.01"/>
        <joint name="hippitch_r" type="hinge" axis="0 1 0" range="-120.0 60.0" damping="1.0" armature="0.01"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.320" size="0.035" rgba=".55 .6 .7 1"/>
        <body name="shin_r" pos="0 0 -0.320">
          <joint name="knee_r" type="hinge" axis="0 1 0" range="0.0 150.0" damping="1.0" armature="0.01"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.320" size="0.030" rgba=".45 .5 .6 1"/>
          <body name="foot_r" pos="0 0 -0.320">
            <joint name="ankle_r" type="hinge" axis="0 1 0" range="-45.0 45.0" damping="1.0" armature="0.01"/>
            <geom name="foot_r" type="box" pos="0.036 0 -0.02" size="0.090 0.045 0.02" friction="1.0" rgba=".2 .2 .2 1"/>
          </body>
        </body>
      </body>
      <body name="chest" pos="0.000 0 0.05">
        <joint name="spine" type="hinge" axis="0 1 0" range="-40.0 40.0" damping="1.0" armature="0.01" stiffness="20.000" springref="0"/>
        <geom type="box" pos="0 0 0.175" size="0.09 0.130 0.175" density="350" rgba=".8 .5 .3 1"/>
        <geom type="sphere" pos="0 0 0.450" size="0.09" density="400" rgba=".9 .9 .9 1"/>
        <body name="uparm_l" pos="0 0.190 0.315">
          <joint name="shoulder_l" type="hinge" axis="0 1 0" range="-180.0 60.0" damping="1.0" armature="0.01"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.250" size="0.03" rgba=".6 .65 .75 1"/>
          <body name="forearm_l" pos="0 0 -0.250">
            <joint name="elbow_l" type="hinge" axis="0 1 0" range="-150.0 0.0" damping="1.0" armature="0.01"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.250" size="0.025" rgba=".6 .65 .75 1"/>
          </body>
        </body>
        <body name="uparm_r" pos="0 -0.190 0.315">
          <joint name="shoulder_r" type="hinge" axis="0 1 0" range="-180.0 60.0" damping="1.0" armature="0.01"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.250" size="0.03" rgba=".6 .65 .75 1"/>
          <body name="forearm_r" pos="0 0 -0.250">
            <joint name="elbow_r" type="hinge" axis="0 1 0" range="-150.0 0.0" damping="1.0" armature="0.01"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.250" size="0.025" rgba=".6 .65 .75 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position name="hiproll_l" joint="hiproll_l" kp="160.0" kv="4.00" inheritrange="1" forcelimited="true" forcerange="-80.0 80.0"/>
    <position name="hippitch_l" joint="hippitch_l" kp="160.0" kv="4.00" inheritrange="1" forcelimited="true" forcerange="-80.0 80.0"/>
    <position name="knee_l" joint="knee_l" kp="160.0" kv="4.00" inheritrange="1" forcelimited="true" forcerange="-80.0 80.0"/>
    <position name="ankle_l" joint="ankle_l" kp="160.0" kv="4.00" inheritrange="1" forcelimited="true" forcerange="-80.0 80.0"/>
    <position name="hiproll_r" joint="hiproll_r" kp="160.0" kv="4.00" inheritrange="1" forcelimited="true" forcerange="-80.0 80.0"/>
    <position name="hippitch_r" joint="hippitch_r" kp="160.0" kv="4.00" inheritrange="1" forcelimited="true" forcerange="-80.0 80.0"/>
    <position name="knee_r" joint="knee_r" kp="160.0" kv="4.00" inheritrange="1" forcelimited="true" forcerange="-80.0 80.0"/>
    <position name="ankle_r" joint="ankle_r" kp="160.0" kv="4.00" inheritrange="1" forcelimited="true" forcerange="-80.0 80.0"/>
    <position name="spine" joint="spine" kp="160.0" kv="4.00" inheritrange="1" forcelimited="true" forcerange="-80.0 80.0"/>
    <position name="shoulder_l" joint="shoulder_l" kp="160.0" kv="4.00" inheritrange="1" forcelimited="true" forcerange="-80.0 80.0"/>
    <position name="elbow_l" joint="elbow_l" kp="160.0" kv="4.00" inheritrange="1" forcelimited="true" forcerange="-80.0 80.0"/>
    <position name="shoulder_r" joint="shoulder_r" kp="160.0" kv="4.00" inheritrange="1" forcelimited="true" forcerange="-80.0 80.0"/>
    <position name="elbow_r" joint="elbow_r" kp="160.0" kv="4.00" inheritrange="1" forcelimited="true" forcerange="-80.0 80.0"/>
  </actuator>
</mujoco>